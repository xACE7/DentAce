      "title": { "en": "Teratogenesis", "ar": "المسخية" },
      "icon": "<svg viewBox=\"0 0 28 28\"><circle cx=\"14\" cy=\"11\" r=\"6\"/><path d=\"M14 17 c-3 0-5 3-5 7 h10 c0-4-2-7-5-7z\"/></svg>",
