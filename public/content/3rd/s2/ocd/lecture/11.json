      "rows": [
        {
          "blk": [
            {
              "h3": {
                "en": "I — initial",
                "ar": "I — الأولية"
              }
            },
            {
              "ul": [
                {
                  "en": "dilated capillaries, ↑ blood flow; [imp]subclinical[/imp]",
                  "ar": "شعيرات متوسّعة، زيادة تدفّق دموي؛ [imp]تحت سريرية[/imp]"
                },
                {
                  "en": "[mic]margination[/mic] — PMNs adhere to vessel walls within ~1 week",
                  "ar": "[mic]التهميش[/mic] — تلتصق العدلات بجدر الأوعية خلال ~أسبوع"
                },
                {
                  "en": "PMNs leave capillaries → CT, JE, sulcus; [exam]perivascular collagen loss[/exam]",
                  "ar": "تغادر العدلات الشعيرات ← النسيج الضام والظهارة الوصلية والميزاب؛ [exam]فقدان كولاجين حول وعائي[/exam]"
                }
              ]
            }
          ],
          "figs": [{ "img": "/3rd-year/3rd-s2/ocd/img/ocd-11-img/ocd-11-progression.jpg", "cap": { "en": "Gingivitis evolves stage by stage", "ar": "يتطوّر التهاب اللثة مرحلةً مرحلة" } }]
        },
        {
          "reverse": true,
          "blk": [
            {
              "h3": {
                "en": "II — early",
                "ar": "II — المبكّرة"
              }
            },
            {
              "ul": [
                {
                  "en": "erythema from capillary loops between [mic]rete pegs[/mic]",
                  "ar": "احمرار من عُرى الشعيرات بين [mic]النتوءات الشبكية[/mic]"
                },
                {
                  "en": "mainly [mic]lymphocytes[/mic]; JE densely infiltrated by neutrophils",
                  "ar": "غالبًا [mic]لمفاويات[/mic]؛ الظهارة الوصلية مرتشحة بكثافة بالعدلات"
                },
                {
                  "en": "↑ collagen destruction; PMNs [exam]phagocytose bacteria[/exam]",
                  "ar": "زيادة تدمير الكولاجين؛ العدلات [exam]تبلعم الجراثيم[/exam]"
                }
              ]
            }
          ]
        },
        {
          "blk": [
            {
              "h3": {
                "en": "III — established & IV — advanced",
                "ar": "III — المستقرّة و IV — المتقدّمة"
              }
            },
            {
              "ul": [
                {
                  "en": "engorged vessels, sluggish flow → [def]anoxemia[/def] → [imp]bluish hue[/imp]",
                  "ar": "أوعية محتقنة، تدفّق بطيء ← [def]نقص أكسجة[/def] ← [imp]مسحة مزرقّة[/imp]"
                },
                {
                  "en": "RBC extravasation + haemoglobin breakdown deepen the colour",
                  "ar": "خروج الكريات الحمر + تحلّل الهيموغلوبين يعمّقان اللون"
                },
                {
                  "en": "[mic]plasma cells[/mic] dominate CT; neutrophils dominate JE",
                  "ar": "[mic]الخلايا البلازمية[/mic] تسود النسيج الضام؛ والعدلات تسود الظهارة الوصلية"
                },
                {
                  "en": "[exam]Advanced:[/exam] damage extends to [imp]bone[/imp] → attachment loss",
                  "ar": "[exam]المتقدّمة:[/exam] يمتدّ الضرر إلى [imp]العظم[/imp] ← فقدان التصاق"
                }
              ]
            }
          ]
        }
      ]
    },
