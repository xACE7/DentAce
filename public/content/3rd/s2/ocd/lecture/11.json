  "lecture": [
    {
      "title": {
        "en": "Healthy Gingiva",
        "ar": "اللثة السليمة"
      },
      "icon": "<svg viewBox=\"0 0 28 28\"><path d=\"M14 4 c5 7 7 9 7 13 a7 7 0 0 1-14 0 c0-4 2-6 7-13z\"></path></svg>",
      "accent": "green",
      "doodle": true,
      "rows": [
        {
          "blk": [
            {
              "p": {
                "en": "Healthy gingiva looks [extra]pink[/extra], is not swollen, and is [imp]firmly attached[/imp] to tooth & bone with [imp]minimal / no bleeding on probing[/imp].",
                "ar": "تبدو اللثة السليمة [extra]وردية[/extra]، غير متورّمة، و[imp]ملتصقة بإحكام[/imp] بالسن والعظم مع [imp]نزف ضئيل / معدوم عند السبر[/imp]."
              }
            }
          ],
          "figs": [{ "img": "/3rd-year/3rd-s2/ocd/img/ocd-11-img/ocd-11-healthy.jpg", "cap": { "en": "Healthy gingiva — pink, firm, stippled", "ar": "لثة سليمة — وردية، متماسكة، منقّطة" } }]
        },
        {
          "reverse": true,
          "blk": [
            {
              "h3": {
                "en": "6 clinical features",
                "ar": "6 صفات سريرية"
              },
              "c": "extra"
            },
            {
              "ul": [
                {
                  "en": "[exam]Colour:[/exam] coral / salmon [extra]pink[/extra]",
                  "ar": "[exam]اللون:[/exam] [extra]وردي[/extra] مرجاني / سلموني"
                },
                {
                  "en": "[exam]Consistency:[/exam] firm, resilient, well-adapted",
                  "ar": "[exam]القوام:[/exam] متماسك، مرن، ملتصق جيدًا"
                },
                {
                  "en": "[exam]Contour:[/exam] scalloped, [mic]knife-edge[/mic] margin, pointed papillae",
                  "ar": "[exam]الكفاف:[/exam] مُسنّن، حافة [mic]كحدّ السكين[/mic]، حليمات مدبّبة"
                },
                {
                  "en": "[exam]Texture:[/exam] matte, [mic]stippled[/mic]",
                  "ar": "[exam]الملمس:[/exam] مطفأ، [mic]منقّط[/mic]"
                },
                {
                  "en": "[exam]Resistance:[/exam] present to probe penetration",
                  "ar": "[exam]المقاومة:[/exam] موجودة لاختراق المسبار"
                },
                {
                  "en": "[exam]Bleeding / pain:[/exam] absent or slight",
                  "ar": "[exam]النزف / الألم:[/exam] غائب أو طفيف"
                }
              ]
            }
          ]
        },
        {
          "blk": [
            {
              "saq": {
                "label": {
                  "en": "recall",
                  "ar": "استرجاع"
                },
                "body": {
                  "en": "healthy colour → [r]coral / salmon pink[/r]",
                  "ar": "لون الصحة → [r]وردي مرجاني / سلموني[/r]"
                }
              }
            }
          ]
        }
      ]
    },
    {
      "title": {
        "en": "Healthy — Histology",
        "ar": "الصحة — النسيج"
      },
      "icon": "<svg viewBox=\"0 0 28 28\"><circle cx=\"12\" cy=\"12\" r=\"7\"></circle><line x1=\"17\" y1=\"17\" x2=\"24\" y2=\"24\"></line></svg>",
      "accent": "blue",
      "doodle": true,
      "rows": [
        {
          "blk": [
            {
              "h3": {
                "en": "epithelium in zones",
                "ar": "الظهارة بمناطق"
              },
              "c": "exam"
            },
            {
              "ul": [
                {
                  "en": "[mic]junctional epithelium[/mic] (A–B)",
                  "ar": "[mic]الظهارة الوصلية[/mic] (A–B)"
                },
                {
                  "en": "[mic]sulcular epithelium[/mic] (B–C)",
                  "ar": "[mic]ظهارة الميزاب[/mic] (B–C)"
                },
                {
                  "en": "[mic]free gingiva[/mic] (C–D) & [mic]attached gingiva[/mic] (D–E)",
                  "ar": "[mic]اللثة الحرّة[/mic] (C–D) و[mic]اللثة الملتصقة[/mic] (D–E)"
                }
              ]
            },
            {
              "p": {
                "en": "Connective tissue = [imp]densely packed collagen bundles[/imp] with only a few scattered inflammatory cells.",
                "ar": "النسيج الضام = [imp]حزم كولاجين متراصّة[/imp] مع خلايا التهابية متناثرة قليلة فقط."
              }
            }
          ]
        },
        {
          "figs": [{ "img": "/3rd-year/3rd-s2/ocd/img/ocd-11-img/ocd-11-histology.jpg", "cap": { "en": "Gingival epithelium zones & connective tissue", "ar": "مناطق ظهارة اللثة والنسيج الضام" } }]
        },
        {
          "reverse": true,
          "blk": [
            {
              "note": {
                "label": {
                  "en": "healthy is \"active\", not sterile",
                  "ar": "الصحة «نشطة» وليست عقيمة"
                },
                "body": {
                  "en": "Some [mic]neutrophils[/mic] answer the constant bacteria in the sulcus; [mic]lymphocytes & macrophages[/mic] also gather. This [def]steady-state equilibrium[/def] of low-grade inflammation can last a [imp]lifetime[/imp] with no clinical gingivitis.",
                  "ar": "بعض [mic]العدلات[/mic] تردّ على الجراثيم الدائمة في الميزاب؛ كما تتجمّع [mic]اللمفاويات والبلاعم[/mic]. هذا [def]التوازن المستقرّ[/def] من التهاب خفيف قد يدوم [imp]العمر كلّه[/imp] دون التهاب لثة سريري."
                }
              }
            },
            {
              "saq": {
                "label": {
                  "en": "recall",
                  "ar": "استرجاع"
                },
                "body": {
                  "en": "healthy sulcus has → [r]very sparse neutrophil migration, no inflammatory response[/r]",
                  "ar": "الميزاب السليم فيه → [r]هجرة عدلات ضئيلة جدًا، بلا استجابة التهابية[/r]"
                }
              }
            }
          ]
        }
      ]
    },
    {
      "title": {
        "en": "How Gingivitis Starts",
        "ar": "كيف يبدأ التهاب اللثة"
      },
      "icon": "<svg viewBox=\"0 0 28 28\"><path d=\"M5 23 l4 0 l0-5 l4 0 l0-5 l4 0 l0-5 l4 0\"></path></svg>",
      "accent": "pink",
      "doodle": true,
      "rows": [
        {
          "blk": [
            {
              "html": "<div class=\"flowtxt\"><span class=\"en\"><span class=\"imp\">plaque accumulation</span></span><span class=\"ar\"><span class=\"imp\">تراكم اللويحة</span></span></div>"
            },
            {
              "html": "<span class=\"dn\"><svg width=\"34\" height=\"34\" viewBox=\"0 0 34 34\"><g class=\"ar-flow\"><path d=\"M17 3 Q9 16 17 26\"></path><path d=\"M17 28 L11 21\"></path><path d=\"M17 28 L23 21\"></path></g></svg></span>"
            },
            {
              "html": "<div class=\"flowtxt\"><span class=\"en\">defence cells infiltrate — <span class=\"mic\">neutrophils, macrophages, plasma cells, lymphocytes</span></span><span class=\"ar\">ارتشاح الخلايا الدفاعية — <span class=\"mic\">عدلات، بلاعم، خلايا بلازمية، لمفاويات</span></span></div>"
            },
            {
              "html": "<span class=\"dn\"><svg width=\"34\" height=\"34\" viewBox=\"0 0 34 34\"><g class=\"ar-flow\"><path d=\"M17 3 Q25 16 17 26\"></path><path d=\"M17 28 L11 21\"></path><path d=\"M17 28 L23 21\"></path></g></svg></span>"
            },
            {
              "html": "<div class=\"flowtxt\"><span class=\"en\">release of <span class=\"imp\">destructive enzymes</span></span><span class=\"ar\">إطلاق <span class=\"imp\">إنزيمات هدّامة</span></span></div>"
            },
            {
              "html": "<span class=\"dn\"><svg width=\"34\" height=\"34\" viewBox=\"0 0 34 34\"><g class=\"ar-flow\"><path d=\"M17 3 Q9 16 17 26\"></path><path d=\"M17 28 L11 21\"></path><path d=\"M17 28 L23 21\"></path></g></svg></span>"
            },
            {
              "html": "<div class=\"flowtxt\"><span class=\"en\"><span class=\"exam\">collagen depletion</span> + JE proliferation</span><span class=\"ar\"><span class=\"exam\">استنزاف الكولاجين</span> + تكاثر الظهارة الوصلية</span></div>"
            }
          ],
          "figs": [{ "img": "/3rd-year/3rd-s2/ocd/img/ocd-11-img/ocd-11-gingivitis.jpg", "cap": { "en": "Plaque-induced gingival inflammation", "ar": "التهاب لثة محرّض باللويحة" } }]
        },
        {
          "reverse": true,
          "blk": [
            {
              "p": {
                "en": "[exam]Vasodilation + ↑ vascular permeability[/exam] → fluid & cells leak in → tissue becomes [imp]erythematous & edematous[/imp].",
                "ar": "[exam]توسّع الأوعية + زيادة النفاذية الوعائية[/exam] ← تسرّب السوائل والخلايا ← يصبح النسيج [imp]محمرًّا ووذميًّا[/imp]."
              }
            },
            {
              "saq": {
                "label": {
                  "en": "recall",
                  "ar": "استرجاع"
                },
                "body": {
                  "en": "why red & swollen? → [r]↑ blood flow (red) + leaked fluid into tissues (swollen)[/r]",
                  "ar": "لماذا أحمر ومتورّم؟ → [r]زيادة التدفّق الدموي (أحمر) + تسرّب السوائل إلى الأنسجة (متورّم)[/r]"
                }
              }
            }
          ]
        }
      ]
    },
