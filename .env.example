# DentAce — environment variables (copy to .env.local and fill in; .env.local is gitignored).
# NEXT_PUBLIC_* values are baked into the static build and shipped to the browser.
# For the deployed GitHub Pages build, set these in the CI/Actions environment (secrets),
# NOT in a committed file.

# --- Site / build ---
# Base path when hosted under a sub-path (GitHub Pages project site), e.g. "/DentAce". Empty for root.
NEXT_PUBLIC_BASE_PATH=
# Absolute site origin, used for canonical/OG/sitemap URLs, e.g. https://xace7.github.io/DentAce
SITE_URL=

# --- Google Analytics (optional) ---
# GA4 Measurement ID, e.g. G-XXXXXXXXXX. Inject via CI secret; do not hard-code in the repo.
NEXT_PUBLIC_GA_ID=

# --- Supabase (browser, public) ---
# Project URL, e.g. https://<your-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Publishable/anon key (sb_publishable_... or legacy anon JWT). Browser-safe — security is via RLS.
NEXT_PUBLIC_SUPABASE_KEY=

# --- Supabase (server-only, for tools/upload-pdfs.mjs) ---
# Same project URL as above (server-side var name).
SUPABASE_URL=
# Secret / service_role key (sb_secret_... ). PRIVILEGED — bypasses RLS. NEVER commit this.
# Used only to upload PDFs to the private 'pdfs' Storage bucket.
SUPABASE_SERVICE_KEY=
