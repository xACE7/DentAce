/node_modules
/.next
/out
/build
*.tsbuildinfo
next-env.d.ts
.DS_Store
npm-debug.log*

# local env (Supabase keys etc.) — never commit
.env*.local
.env.local

# Source PDFs are served from the private Supabase 'pdfs' Storage bucket (signed URLs),
# not from the repo. Keep them locally for dev fallback / re-upload, but don't track them.
# (Already-tracked PDFs must be removed with `git rm --cached` once they're in the bucket.)
public/**/pdf/
